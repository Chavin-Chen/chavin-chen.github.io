[{"sourceNumber":1777,"stem":"结核菌素试验注射后，观察结果的时间为","options":{"A":"12 小时","B":"12～24 小时","C":"24～48 小时","D":"48～72 小时","E":"72 小时后"},"answer":"D","section":"单选题","id":1777,"book":"护理三基考试3000题","explanation":"结核菌素反应是迟发型细胞免疫反应，需在注射后一段时间测量硬结。"},{"sourceNumber":1778,"stem":"A 型胃炎可有","options":{"A":"幽门螺杆菌阳性","B":"血清促胃液素明显降低","C":"胃酸缺乏","D":"抗壁细胞抗体阴性","E":"甲胎蛋白增高"},"answer":"C","section":"单选题","id":1778,"book":"护理三基考试3000题","explanation":"自身免疫性胃体炎破坏分泌胃酸的壁细胞，胃酸可显著减少。"},{"sourceNumber":1779,"stem":"成人女性血红蛋白的参考值范围是","options":{"A":"100~140g/L","B":"140~170 g/L","C":"110~150 g/L","D":"170~200 g/L","E":"120~160 g/L"},"answer":"C","section":"单选题","id":1779,"book":"护理三基考试3000题","explanation":"此题使用传统教材参考范围，血红蛋白判读还应区分年龄、妊娠和实验室标准。"},{"sourceNumber":1780,"stem":"糖尿病患者最基本的治疗措施是","options":{"A":"体育锻炼","B":"药物治疗","C":"饮食治疗","D":"并发症治疗","E":"注射胰岛素"},"answer":"C","section":"单选题","id":1780,"book":"护理三基考试3000题","explanation":"进食量及碳水化合物分配影响餐后血糖，营养管理贯穿各阶段治疗。"},{"sourceNumber":1781,"stem":"急性脑血管病首选的检查项目是","options":{"A":"脑脊液检查","B":"CT","C":"MRI","D":"脑电图","E":"头颅摄片"},"answer":"B","section":"单选题","id":1781,"book":"护理三基考试3000题","explanation":"急诊头颅平扫CT能迅速识别脑出血，帮助确定后续卒中处理路径。"},{"sourceNumber":1782,"stem":"出生即存在并终生不消失的反射是","options":{"A":"巴宾斯基征","B":"克匿格氏征","C":"布鲁金斯基征","D":"角膜反射","E":"霍夫曼斯征"},"answer":"D","section":"单选题","id":1782,"book":"护理三基考试3000题","explanation":"角膜刺激引起瞬目是脑干保护性反射，正常情况下可终生保留。"},{"sourceNumber":1783,"stem":"属于缺血性脑血管病的是","options":{"A":"脑出血","B":"脑血栓形成","C":"蛛网膜下腔出血","D":"大脑中动脉出血","E":"豆纹动脉出血"},"answer":"B","section":"单选题","id":1783,"book":"护理三基考试3000题","explanation":"脑动脉被血栓阻塞导致相应供血区缺血，与血管破裂性卒中不同。"},{"sourceNumber":1784,"stem":"肠鸣音亢进时每分钟至少能听到","options":{"A":"2 次","B":"4 次","C":"6 次","D":"8 次","E":"10 次"},"answer":"E","section":"单选题","id":1784,"book":"护理三基考试3000题","explanation":"肠鸣音明显频繁、高亢提示肠蠕动增强，教材常取每分钟约10次以上为参考。"},{"sourceNumber":1785,"stem":"胃癌易向下列何处淋巴结转移","options":{"A":"左颈部淋巴结","B":"左腋窝淋巴结","C":"左锁骨下淋巴结","D":"左锁骨上淋巴结","E":"左腹股沟淋巴结"},"answer":"D","section":"单选题","id":1785,"book":"护理三基考试3000题","explanation":"胃部肿瘤可沿淋巴系统经胸导管方向扩散，出现左锁骨上淋巴结肿大。"},{"sourceNumber":1786,"stem":"新鲜尿中出现盐类结晶伴有较多红细胞应考虑为","options":{"A":"急性肾炎","B":"肾脏结石","C":"磺胺药过量","D":"肾脏结核","E":"急性肾盂肾炎"},"answer":"B","section":"单选题","id":1786,"book":"护理三基考试3000题","explanation":"结石摩擦可损伤尿路黏膜引起血尿，盐类结晶提供相关线索，仍需影像证实。"},{"sourceNumber":1787,"stem":"痰液有恶臭味，提示为何感染","options":{"A":"病毒","B":"厌氧菌","C":"绿脓杆菌","D":"真菌","E":"化脓菌"},"answer":"B","section":"单选题","id":1787,"book":"护理三基考试3000题","explanation":"恶臭脓液或痰液提示厌氧菌参与感染，与厌氧代谢产物有关，最终需结合临床和检验判定。"},{"sourceNumber":1788,"stem":"心尖部第 1 心音减弱见于","options":{"A":"心室肥大","B":"发热","C":"甲状腺功能亢进","D":"心肌炎","E":"二尖瓣狭窄"},"answer":"D","section":"单选题","id":1788,"book":"护理三基考试3000题","explanation":"心肌炎使心肌收缩减弱，可使心尖部第一心音减弱。"},{"sourceNumber":1789,"stem":"舟状腹常见于","options":{"A":"肝硬化","B":"低血糖","C":"恶液质","D":"腹膜炎","E":"胃扩张"},"answer":"C","section":"单选题","id":1789,"book":"护理三基考试3000题","explanation":"重度消耗使腹壁脂肪和肌肉减少，形成腹部向内凹陷的外观。"},{"sourceNumber":1790,"stem":"呼吸气味呈刺激性蒜味见于","options":{"A":"支气管扩张","B":"有机磷农药中毒","C":"尿毒症","D":"肺脓肿","E":"酮症酸中毒"},"answer":"B","section":"单选题","id":1790,"book":"护理三基考试3000题","explanation":"蒜样气味配合缩瞳、流涎及多汗等表现提示胆碱能中毒，单凭气味不能确诊。"},{"sourceNumber":1791,"stem":"白细胞分类计数，中性粒细胞（包括杆状核，分叶核）正常应占","options":{"A":"0．5～1．0","B":"0．5～0．7","C":"0．3～0．8","D":"0．7～0．8","E":"0．2～0．4"},"answer":"B","section":"单选题","id":1791,"book":"护理三基考试3000题","explanation":"中性粒细胞包括杆状核和分叶核，在成人白细胞中占多数。"},{"sourceNumber":1792,"stem":"下列何种疾病血沉无明显增快","options":{"A":"急性心肌梗死","B":"心绞痛","C":"恶性肿瘤晚期","D":"活动性结核","E":"活动性风湿热"},"answer":"B","section":"单选题","id":1792,"book":"护理三基考试3000题","explanation":"单纯短暂心肌缺血往往无广泛坏死或明显全身炎症，血沉可无显著变化。"}]