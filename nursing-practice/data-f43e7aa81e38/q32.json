[{"sourceNumber":513,"stem":"输血时不必检查血型的是输","options":{"A":"血球","B":"血清","C":"血浆","D":"库存血","E":"新鲜血"},"answer":"","section":"单选题","original_answer":"C","note":"输血浆仍需考虑 ABO 相容，不能用“不必检查血型”作依据。","source_url":"https://www.nhc.gov.cn/ewebeditor/uploadfile/2019/01/20190110142510147.pdf","explanation":"输血浆仍需考虑 ABO 相容，不能用“不必检查血型”作依据。","id":513,"book":"护理三基考试3000题"},{"sourceNumber":514,"stem":"脑水肿颅内高压者应注意观察","options":{"A":"意识","B":"瞳孔","C":"脉搏","D":"呼吸","E":"血压"},"answer":"B","section":"单选题","explanation":"新发瞳孔不等大、光反射改变可提示颅压增高和脑疝。","id":514,"book":"护理三基考试3000题"},{"sourceNumber":515,"stem":"服用洋地黄药物应注意观察","options":{"A":"意识","B":"瞳孔","C":"脉搏","D":"呼吸","E":"血压"},"answer":"C","section":"单选题","explanation":"洋地黄可减慢传导并诱发心律失常，服药时须观察心率节律。","id":515,"book":"护理三基考试3000题"},{"sourceNumber":516,"stem":"保留灌肠肛管插入约","options":{"A":"7～10cm","B":"10～15cm","C":"15～20cm","D":"20～25cm","E":"25cm 以上"},"answer":"C","section":"单选题","explanation":"成人传统保留灌肠将药液送到稍深位置以减少排便刺激，具体深度受器械和患者影响。","id":516,"book":"护理三基考试3000题"},{"sourceNumber":517,"stem":"清洁灌肠肛管插入约","options":{"A":"7～10cm","B":"10～15cm","C":"15～20cm","D":"20～25cm","E":"25cm 以上"},"answer":"B","section":"单选题","explanation":"清洁灌肠需使管端越过肛门括约肌并避免损伤，成人传统插入深度约 10–15 cm。","id":517,"book":"护理三基考试3000题"},{"sourceNumber":518,"stem":"错输血型病人的尿呈","options":{"A":"黄褐色","B":"乳白色","C":"鲜红色","D":"果酱色","E":"黄白色并浑浊"},"answer":"","section":"单选题","original_answer":"D","note":"急性溶血后血红蛋白尿常呈红褐或酱油色，“果酱色”容易与粪便表现混淆。","explanation":"急性溶血后血红蛋白尿常呈红褐或酱油色，“果酱色”容易与粪便表现混淆。","id":518,"book":"护理三基考试3000题"},{"sourceNumber":519,"stem":"丝虫病病人的尿呈","options":{"A":"黄褐色","B":"乳白色","C":"鲜红色","D":"果酱色","E":"黄白色并浑浊"},"answer":"B","section":"单选题","explanation":"淋巴管与泌尿道异常交通可造成乳糜尿，尿液外观乳白。","id":519,"book":"护理三基考试3000题"},{"sourceNumber":520,"stem":"膀胱炎病人的尿呈","options":{"A":"黄褐色","B":"乳白色","C":"鲜红色","D":"果酱色","E":"黄白色并浑浊"},"answer":"E","section":"单选题","explanation":"白细胞及细菌可使感染尿液浑浊，但外观不是单独诊断依据。","id":520,"book":"护理三基考试3000题"},{"sourceNumber":521,"stem":"25%～35%乙醇擦浴适用于","options":{"A":"足部软组织扭伤早期","B":"促进肠蠕动，减轻肠胀气","C":"急性乳腺炎早期","D":"会阴部充血，炎症和疼痛","E":"高热"},"answer":"","section":"单选题","original_answer":"E","note":"乙醇擦浴可能引起吸收和寒战，不应将其列作所有高热患者的常规疗法。","explanation":"乙醇擦浴可能引起吸收和寒战，不应将其列作所有高热患者的常规疗法。","id":521,"book":"护理三基考试3000题"},{"sourceNumber":522,"stem":"患部冷敷用于","options":{"A":"足部软组织扭伤早期","B":"促进肠蠕动，减轻肠胀气","C":"急性乳腺炎早期","D":"会阴部充血，炎症和疼痛","E":"高热"},"answer":"A","section":"单选题","explanation":"早期短时用冷可减轻局部疼痛与肿胀，要避免冻伤。","id":522,"book":"护理三基考试3000题"},{"sourceNumber":523,"stem":"患部热敷用于","options":{"A":"足部软组织扭伤早期","B":"促进肠蠕动，减轻肠胀气","C":"急性乳腺炎早期","D":"会阴部充血，炎症和疼痛","E":"高热"},"answer":"","section":"单选题","original_answer":"C","note":"不同阶段、类型的乳腺炎不宜统一推荐热敷，需按病情处理。","explanation":"不同阶段、类型的乳腺炎不宜统一推荐热敷，需按病情处理。","id":523,"book":"护理三基考试3000题"},{"sourceNumber":524,"stem":"尿毒症者","options":{"A":"呼气有臭味","B":"呼气有氨味","C":"呼气有烂苹果味","D":"呼气有大蒜味","E":"呼气有鱼腥味"},"answer":"B","section":"单选题","explanation":"唾液中尿素可分解产生氨，尿毒症时呼气可带氨味。","id":524,"book":"护理三基考试3000题"},{"sourceNumber":525,"stem":"糖尿病昏迷者","options":{"A":"呼气有臭味","B":"呼气有氨味","C":"呼气有烂苹果味","D":"呼气有大蒜味","E":"呼气有鱼腥味"},"answer":"C","section":"单选题","explanation":"糖尿病酮症酸中毒产生挥发性丙酮，呼气可有烂苹果味。","id":525,"book":"护理三基考试3000题"},{"sourceNumber":526,"stem":"有机磷农药中毒者","options":{"A":"呼气有臭味","B":"呼气有氨味","C":"呼气有烂苹果味","D":"呼气有大蒜味","E":"呼气有鱼腥味"},"answer":"D","section":"单选题","explanation":"某些有机磷制剂可有蒜样气味，仅作接触史线索。","id":526,"book":"护理三基考试3000题"},{"sourceNumber":527,"stem":"乙醇湿化吸氧适用于","options":{"A":"肺气肿","B":"肺水肿","C":"缺氧伴二氧化碳潴留","D":"缺氧不伴二氧化碳潴留","E":"心力衰竭"},"answer":"","section":"单选题","original_answer":"B","note":"乙醇湿化“消泡”是旧题说法，不应当作肺水肿标准氧疗。","explanation":"乙醇湿化“消泡”是旧题说法，不应当作肺水肿标准氧疗。","id":527,"book":"护理三基考试3000题"},{"sourceNumber":528,"stem":"低流量持续给氧适用于","options":{"A":"肺气肿","B":"肺水肿","C":"缺氧伴二氧化碳潴留","D":"缺氧不伴二氧化碳潴留","E":"心力衰竭"},"answer":"C","section":"单选题","explanation":"二氧化碳潴留风险者需控制给氧，并按氧饱和度及动脉血气调整。","id":528,"book":"护理三基考试3000题"}]