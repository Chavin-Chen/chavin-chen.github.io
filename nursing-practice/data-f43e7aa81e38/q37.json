[{"sourceNumber":593,"stem":"体温上升期特点","options":{"A":"产热与散热平衡","B":"产热大于散热","C":"产热小于散热","D":"体温在较高水平上趋于平衡","E":"产热散热不平衡"},"answer":"B","section":"单选题","explanation":"调定点上移时产热增多或散热减少，净储热使体温升高。","id":593,"book":"护理三基考试3000题"},{"sourceNumber":594,"stem":"高热持续期特点","options":{"A":"产热与散热平衡","B":"产热大于散热","C":"产热小于散热","D":"体温在较高水平上趋于平衡","E":"产热散热不平衡"},"answer":"D","section":"单选题","explanation":"体温在较高水平稳定时，产热和散热重新趋于平衡。","id":594,"book":"护理三基考试3000题"},{"sourceNumber":595,"stem":"上消化道出血的病人粪便为","options":{"A":"鲜红色便","B":"陶土色便","C":"果酱样便","D":"柏油便","E":"暗红色便"},"answer":"D","section":"单选题","explanation":"消化道分解血红蛋白形成黑色物质，故较慢的上消化道出血可有柏油便。","id":595,"book":"护理三基考试3000题"},{"sourceNumber":596,"stem":"胆道完全阻塞的病人粪便为","options":{"A":"鲜红色便","B":"陶土色便","C":"果酱样便","D":"柏油便","E":"暗红色便"},"answer":"B","section":"单选题","explanation":"胆汁无法进入肠道，形成粪胆素减少，粪色变浅如陶土。","id":596,"book":"护理三基考试3000题"},{"sourceNumber":597,"stem":"阿米巴痢疾的病人粪便为","options":{"A":"鲜红色便","B":"陶土色便","C":"果酱样便","D":"柏油便","E":"暗红色便"},"answer":"C","section":"单选题","explanation":"阿米巴性肠黏膜溃疡可使暗红血液混入黏液粪便。","id":597,"book":"护理三基考试3000题"},{"sourceNumber":598,"stem":"发热病人易出现","options":{"A":"速脉","B":"缓脉","C":"间歇脉","D":"丝脉","E":"洪脉"},"answer":"E","section":"单选题","explanation":"发热时代谢和循环增强，有些患者可摸到充盈有力的脉搏。","id":598,"book":"护理三基考试3000题"},{"sourceNumber":599,"stem":"大出血前期病人出现","options":{"A":"速脉","B":"缓脉","C":"间歇脉","D":"丝脉","E":"洪脉"},"answer":"A","section":"单选题","explanation":"失血造成循环容量下降，交感代偿使心率加快。","id":599,"book":"护理三基考试3000题"},{"sourceNumber":600,"stem":"病人患有阿米巴痢疾，其粪便呈","options":{"A":"暗红色便","B":"柏油样便","C":"白陶土样便","D":"果酱样便","E":"粪便表面鲜红"},"answer":"D","section":"单选题","explanation":"黏液和暗红血液混合可造成阿米巴痢疾典型的果酱样便。","id":600,"book":"护理三基考试3000题"},{"sourceNumber":601,"stem":"病人胆道完全梗阻时，其粪便呈","options":{"A":"暗红色便","B":"柏油样便","C":"白陶土样便","D":"果酱样便","E":"粪便表面鲜红"},"answer":"C","section":"单选题","explanation":"总胆道完全阻塞使粪胆素减少，粪便呈灰白色。","id":601,"book":"护理三基考试3000题"},{"sourceNumber":602,"stem":"一般病室冬季的温度","options":{"A":"18～20℃","B":"20～22℃","C":"22～24℃","D":"25～26℃","E":"26～28℃"},"answer":"A","section":"单选题","explanation":"旧教材给出的冬季普通病室范围以维持舒适为目标，应根据患者和设施调节。","id":602,"book":"护理三基考试3000题"},{"sourceNumber":603,"stem":"婴幼儿室适宜的温度","options":{"A":"18～20℃","B":"20～22℃","C":"22～24℃","D":"25～26℃","E":"26～28℃"},"answer":"B","section":"单选题","explanation":"婴幼儿体温调节未成熟，环境通常比普通成人病室略暖，并需个体评估。","id":603,"book":"护理三基考试3000题"},{"sourceNumber":604,"stem":"心肺疾病引起的呼吸困难采用","options":{"A":"侧卧位","B":"中凹卧位","C":"坐位","D":"仰卧位","E":"膝胸位"},"answer":"C","section":"单选题","explanation":"坐位使膈肌下降、胸腔容积增大，部分患者呼吸更省力。","id":604,"book":"护理三基考试3000题"},{"sourceNumber":605,"stem":"矫正子宫后倾或胎位不正采用","options":{"A":"端坐位","B":"头低足高位","C":"头高足低位","D":"半坐卧位","E":"侧卧位"},"answer":"","section":"单选题","original_answer":"E","note":"原题将子宫后倾与胎位异常合并，又给出侧卧位，缺少一致且明确的指征。","explanation":"原题将子宫后倾与胎位异常合并，又给出侧卧位，缺少一致且明确的指征。","id":605,"book":"护理三基考试3000题"},{"sourceNumber":606,"stem":"可以减轻颅内压，预防脑水肿的体位是","options":{"A":"端坐位","B":"头低足高位","C":"头高足低位","D":"半坐卧位","E":"侧卧位"},"answer":"C","section":"单选题","explanation":"适当抬高床头有助于颅内静脉回流，应同时避免颈部过度屈曲。","id":606,"book":"护理三基考试3000题"},{"sourceNumber":607,"stem":"妊娠时胎膜早破，可以防止脐带脱落的体位是","options":{"A":"端坐位","B":"头低足高位","C":"头高足低位","D":"半坐卧位","E":"侧卧位"},"answer":"","section":"单选题","raw":"妊娠时胎膜早破，可以防止脐带脱落的体位是答案：B\nA:．感冒\nB:．肿瘤性发热\nC:．疟疾D:．败血症E:．伤寒\n","note":"胎膜早破并不等于已发生脐带脱垂，应结合先露部、胎心和产科评估判断。","original_answer":"B","explanation":"胎膜早破并不等于已发生脐带脱垂，应结合先露部、胎心和产科评估判断。","id":607,"book":"护理三基考试3000题"},{"sourceNumber":608,"stem":"体温达 39℃以上，持续数日或数周，日差不超过 1℃的热型常见于","options":{"A":"感冒","B":"肿瘤性发热","C":"疟疾","D":"败血症","E":"伤寒"},"answer":"E","section":"单选题","explanation":"持续高热、日波动小于 1℃称稽留热，是伤寒的经典描述之一。","id":608,"book":"护理三基考试3000题"}]