[{"sourceNumber":561,"stem":"肾切除术的体位是","options":{"A":"仰卧位","B":"截石位","C":"俯卧位","D":"侧卧位","E":"膝胸位"},"answer":"D","section":"单选题","explanation":"侧卧便于暴露腰部肾区，具体手术体位也随入路改变。","id":561,"book":"护理三基考试3000题"},{"sourceNumber":562,"stem":"膀胱镜检查的体位是","options":{"A":"仰卧位","B":"截石位","C":"俯卧位","D":"侧卧位","E":"膝胸位"},"answer":"B","section":"单选题","explanation":"截石位便于暴露尿道口并置入膀胱镜。","id":562,"book":"护理三基考试3000题"},{"sourceNumber":563,"stem":"全麻未清醒病人取","options":{"A":"去枕平卧头偏向一侧","B":"头高斜坡位","C":"半卧位","D":"去枕平卧 6～8h","E":"平卧于硬板床"},"answer":"","section":"单选题","original_answer":"A","note":"麻醉未清醒时需按气道、误吸风险及手术部位安置体位，不能一概去枕平卧。","explanation":"麻醉未清醒时需按气道、误吸风险及手术部位安置体位，不能一概去枕平卧。","id":563,"book":"护理三基考试3000题"},{"sourceNumber":564,"stem":"麻醉解除且血压平稳后，颈、胸、腹部手术病人应取","options":{"A":"去枕平卧头偏向一侧","B":"头高斜坡位","C":"半卧位","D":"去枕平卧 6～8h","E":"平卧于硬板床"},"answer":"C","section":"单选题","explanation":"生命体征稳定后适当半卧有利于呼吸、引流并减轻切口张力。","id":564,"book":"护理三基考试3000题"},{"sourceNumber":565,"stem":"氰化物中毒者宜用","options":{"A":"清水","B":"茶叶水","C":"5％硫酸镁","D":"生理盐水","E":"硫代硫酸钠"},"answer":"E","section":"单选题","explanation":"硫代硫酸钠可提供硫供体，帮助把氰化物转变为较低毒性的硫氰酸盐。","id":565,"book":"护理三基考试3000题"},{"sourceNumber":566,"stem":"未明原因的中毒口服","options":{"A":"清水","B":"茶叶水","C":"5％硫酸镁","D":"生理盐水","E":"硫代硫酸钠"},"answer":"","section":"单选题","original_answer":"D","note":"中毒物不明时不能把口服生理盐水当作通用解毒治疗。","source_url":"https://eapcct.org/wp-content/uploads/2024/09/PS2013_GastricLavage.pdf","explanation":"中毒物不明时不能把口服生理盐水当作通用解毒治疗。","id":566,"book":"护理三基考试3000题"},{"sourceNumber":567,"stem":"重金属中毒者宜用","options":{"A":"清水","B":"茶叶水","C":"5％硫酸镁","D":"生理盐水","E":"硫代硫酸钠"},"answer":"","section":"单选题","original_answer":"B","note":"茶叶水不是重金属中毒的通用解毒剂，治疗需区分毒物并评估螯合指征。","source_url":"https://eapcct.org/wp-content/uploads/2024/09/PS2013_GastricLavage.pdf","explanation":"茶叶水不是重金属中毒的通用解毒剂，治疗需区分毒物并评估螯合指征。","id":567,"book":"护理三基考试3000题"},{"sourceNumber":568,"stem":"胃大部切除术后","options":{"A":"去枕平卧，头侧向一侧","B":"侧卧位","C":"半卧位","D":"去枕平卧 6～8ｈ","E":"头高足低位"},"answer":"C","section":"单选题","explanation":"循环稳定后适当半卧可减少腹部切口牵拉，并改善通气。","id":568,"book":"护理三基考试3000题"},{"sourceNumber":569,"stem":"颅脑手术后","options":{"A":"去枕平卧，头侧向一侧","B":"侧卧位","C":"半卧位","D":"去枕平卧 6～8ｈ","E":"头高足低位"},"answer":"E","section":"单选题","explanation":"抬高床头有利于颅静脉回流，实际角度须兼顾颅压和脑灌注。","id":569,"book":"护理三基考试3000题"},{"sourceNumber":570,"stem":"糖尿病病人的饮食","options":{"A":"高热量、高蛋白、高维生素、低纤维","B":"控制总热量、低糖、低脂、高纤维素、适当蛋白质","C":"低脂、低热量、少盐、粗纤维","D":"高蛋白、高纤维、高铁饮食","E":"低热量、低盐、高纤维、易消化饮食"},"answer":"B","section":"单选题","explanation":"饮食治疗重点是匹配能量需要、合理分配碳水并选择富含纤维的食物。","id":570,"book":"护理三基考试3000题"},{"sourceNumber":571,"stem":"慢性心衰病人的饮食","options":{"A":"高热量、高蛋白、高维生素、低纤维","B":"控制总热量、低糖、低脂、高纤维素、适当蛋白质","C":"低脂、低热量、少盐、粗纤维","D":"高蛋白、高纤维、高铁饮食","E":"低热量、低盐、高纤维、易消化饮食"},"answer":"E","section":"单选题","explanation":"心衰患者常需控制钠和液体负荷，热量则应根据营养状态决定。","id":571,"book":"护理三基考试3000题"},{"sourceNumber":572,"stem":"输液后引起静脉炎的原因是","options":{"A":"输入致热物质","B":"输入致敏物质","C":"输入药液浓度过高","D":"输入药液量大，速度过快","E":"输液滴管中空气未排尽"},"answer":"C","section":"单选题","explanation":"高浓度或刺激性液体可损伤血管内皮，导致化学性静脉炎。","id":572,"book":"护理三基考试3000题"},{"sourceNumber":573,"stem":"输液中发现肺水肿的原因是","options":{"A":"输入致热物质","B":"输入致敏物质","C":"输入药液浓度过高","D":"输入药液量大，速度过快","E":"输液滴管中空气未排尽"},"answer":"D","section":"单选题","explanation":"血容量过快增加会加重心脏负担，使肺毛细血管液体外渗。","id":573,"book":"护理三基考试3000题"},{"sourceNumber":574,"stem":"服用助消化药需在","options":{"A":"饭前服","B":"饭后服","C":"睡前服","D":"服药后多饮水","E":"服药后不饮水"},"answer":"B","section":"单选题","explanation":"pc 是饭后的旧医嘱缩写，助消化剂的具体时点取决于制剂。","id":574,"book":"护理三基考试3000题"},{"sourceNumber":575,"stem":"服用退热药需","options":{"A":"饭前服","B":"饭后服","C":"睡前服","D":"服药后多饮水","E":"服药后不饮水"},"answer":"D","section":"单选题","explanation":"发热出汗时需补充所失水分，但心肾功能受限者应按个体液量计划执行。","id":575,"book":"护理三基考试3000题"},{"sourceNumber":576,"stem":"服用健胃药需在","options":{"A":"饭前服","B":"饭后服","C":"睡前服","D":"服药后多饮水","E":"服药后不饮水"},"answer":"A","section":"单选题","explanation":"传统苦味健胃剂在餐前使用，以刺激食欲及消化液分泌。","id":576,"book":"护理三基考试3000题"}]