[{"sourceNumber":1937,"stem":"原因未明的急性中毒洗胃可用答","options":{"A":"茶叶水","B":"阿托品","C":"清水","D":"蛋清","E":"硫代硫酸钠"},"answer":"","section":"单选题","id":1937,"book":"护理三基考试3000题","original_answer":"C","note":"未知毒物摄入不能按“先洗胃”处理，应评估毒物、时间及气道风险。","explanation":"未知毒物摄入不能按“先洗胃”处理，应评估毒物、时间及气道风险。"},{"sourceNumber":1938,"stem":"有机磷农药中毒所致急性肺水肿选用","options":{"A":"茶叶水","B":"阿托品","C":"清水","D":"蛋清","E":"硫代硫酸钠"},"answer":"B","section":"单选题","id":1938,"book":"护理三基考试3000题","explanation":"阿托品可拮抗毒蕈碱样作用，减少过多气道分泌物并改善支气管痉挛。"},{"sourceNumber":1939,"stem":"以昏睡和精神错乱为主，大部分时间呈昏睡状态，可唤醒","options":{"A":"亚临床肝性脑病","B":"肝性脑病前驱期","C":"肝性脑病昏睡期","D":"肝性脑病昏迷期","E":"肝性脑病昏迷前期"},"answer":"C","section":"单选题","id":1939,"book":"护理三基考试3000题","explanation":"大部分时间嗜睡但还能唤醒，说明意识受损较深而未完全进入昏迷。"},{"sourceNumber":1940,"stem":"意识完全丧失，不能唤醒，扑击样震颤无法引出","options":{"A":"亚临床肝性脑病","B":"肝性脑病前驱期","C":"肝性脑病昏睡期","D":"肝性脑病昏迷期","E":"肝性脑病昏迷前期"},"answer":"D","section":"单选题","raw":"．意识完全丧失，不能唤醒，扑击样震颤无法引出答案：D\nA:．生理盐水B:．稀释醋C:．碳酸氢钠D:．茶叶水\nE:．1：1000 高锰酸钾溶液","note":"原文选项跨题错位，已按共用备选项组（原题 1939）复原。","id":1940,"book":"护理三基考试3000题","explanation":"完全不能唤醒时已无法配合伸臂检查，不能引出扑翼样震颤不代表好转。"},{"sourceNumber":1941,"stem":"有机磷农药中毒选用","options":{"A":"生理盐水","B":"稀释醋","C":"碳酸氢钠","D":"茶叶水","E":"1：1000 高锰酸钾溶液"},"answer":"","section":"单选题","id":1941,"book":"护理三基考试3000题","original_answer":"C","note":"不同有机磷制剂反应不同，未知制剂时不可笼统选碱性洗胃液。","explanation":"不同有机磷制剂反应不同，未知制剂时不可笼统选碱性洗胃液。"},{"sourceNumber":1942,"stem":"重金属生物碱等中毒选用","options":{"A":"生理盐水","B":"稀释醋","C":"碳酸氢钠","D":"茶叶水","E":"1：1000 高锰酸钾溶液"},"answer":"","section":"单选题","id":1942,"book":"护理三基考试3000题","original_answer":"D","note":"茶水不能作为重金属或生物碱中毒的通用解毒剂，治疗须按具体毒物判断。","explanation":"茶水不能作为重金属或生物碱中毒的通用解毒剂，治疗须按具体毒物判断。"},{"sourceNumber":1943,"stem":"原因不明的急性中毒选用","options":{"A":"生理盐水","B":"稀释醋","C":"碳酸氢钠","D":"茶叶水","E":"1：1000 高锰酸钾溶液"},"answer":"","section":"单选题","raw":"．原因不明的急性中毒选用答案：A A:．肾小管吸收障碍\nB:．原尿渗透压高C:．饮水过多\nD:．醛固酮分泌减少\nE:．抗利尿激素分泌不足","note":"毒物不明时不能把生理盐水洗胃列为默认处置，应先作中毒及气道风险评估。","id":1943,"book":"护理三基考试3000题","original_answer":"A","explanation":"毒物不明时不能把生理盐水洗胃列为默认处置，应先作中毒及气道风险评估。"},{"sourceNumber":1944,"stem":"尿崩症多尿是因","options":{"A":"肾小管吸收障碍","B":"原尿渗透压高","C":"饮水过多","D":"醛固酮分泌减少","E":"抗利尿激素分泌不足"},"answer":"E","section":"单选题","id":1944,"book":"护理三基考试3000题","explanation":"中枢性尿崩症因抗利尿激素不足而排大量稀尿；肾性尿崩症则是肾脏反应不足。"},{"sourceNumber":1945,"stem":"糖尿病多尿是因","options":{"A":"肾小管吸收障碍","B":"原尿渗透压高","C":"饮水过多","D":"醛固酮分泌减少","E":"抗利尿激素分泌不足"},"answer":"B","section":"单选题","id":1945,"book":"护理三基考试3000题","explanation":"滤过的糖超出肾小管重吸收能力，使管腔渗透压升高并带走水分。"},{"sourceNumber":1946,"stem":"垂体前叶功能亢进","options":{"A":"巨人症","B":"甲状腺功能亢进症","C":"尿崩症","D":"侏儒症","E":"呆小病"},"answer":"A","section":"单选题","id":1946,"book":"护理三基考试3000题","explanation":"骨骺闭合前生长激素过多可使身高过度增长，闭合后主要表现为肢端肥大。"},{"sourceNumber":1947,"stem":"垂体前叶功能减退","options":{"A":"巨人症","B":"甲状腺功能亢进症","C":"尿崩症","D":"侏儒症","E":"呆小病"},"answer":"D","section":"单选题","id":1947,"book":"护理三基考试3000题","explanation":"儿童生长激素不足可造成身材矮小，应与其他内分泌及骨骼病因鉴别。"},{"sourceNumber":1948,"stem":"三度房室传导阻滞","options":{"A":"奇脉","B":"缓脉","C":"三联律","D":"短绌脉","E":"速脉"},"answer":"B","section":"单选题","id":1948,"book":"护理三基考试3000题","explanation":"三度房室传导阻滞时心室由较慢的逸搏节律驱动，故常见心动过缓。"},{"sourceNumber":1949,"stem":"心包积液可出现","options":{"A":"奇脉","B":"缓脉","C":"三联律","D":"短绌脉","E":"速脉"},"answer":"A","section":"单选题","id":1949,"book":"护理三基考试3000题","explanation":"心包压塞时心室相互依赖增强，吸气时收缩压下降幅度增大，形成奇脉。"},{"sourceNumber":1950,"stem":"大出血前期可出现","options":{"A":"奇脉","B":"缓脉","C":"三联律","D":"短绌脉","E":"速脉"},"answer":"E","section":"单选题","id":1950,"book":"护理三基考试3000题","explanation":"失血早期交感兴奋，心率加快以代偿每搏输出量下降。"},{"sourceNumber":1951,"stem":"洋地黄中毒可出现","options":{"A":"奇脉","B":"缓脉","C":"三联律","D":"短绌脉","E":"速脉"},"answer":"C","section":"单选题","id":1951,"book":"护理三基考试3000题","explanation":"洋地黄中毒可增加异位搏动，早搏按每三个搏动重复的模式出现称三联律。"},{"sourceNumber":1952,"stem":"心房颤动可出现","options":{"A":"奇脉","B":"缓脉","C":"三联律","D":"短绌脉","E":"速脉"},"answer":"D","section":"单选题","id":1952,"book":"护理三基考试3000题","explanation":"部分心搏的搏出量太小，脉搏波传不到桡动脉，因此同一分钟内脉率低于心率。"}]