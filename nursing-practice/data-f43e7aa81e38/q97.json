[{"sourceNumber":1553,"stem":"四肢对称性肌肉瘫痪及呼吸肌麻痹，脑脊液蛋白细胞分离考虑为","options":{"A":"急性感染性多发性神经炎","B":"蛛网膜下腔出血","C":"短暂性脑缺血","D":"脑出血","E":"脑血栓形成"},"answer":"A","section":"单选题","id":1553,"book":"护理三基考试3000题","explanation":"对称性弛缓性瘫痪加上脑脊液蛋白升高而细胞数不明显增加，提示吉兰–巴雷综合征。"},{"sourceNumber":1554,"stem":"在动脉硬化基础上安静状态下缓慢起病，2～3 天达高峰，脑脊液多正常考虑为","options":{"A":"急性感染性多发性神经炎","B":"蛛网膜下腔出血","C":"短暂性脑缺血","D":"脑出血","E":"脑血栓形成"},"answer":"E","section":"单选题","id":1554,"book":"护理三基考试3000题","explanation":"大动脉粥样硬化基础上出现渐进性局灶缺损，符合血栓性梗死的传统题型。"},{"sourceNumber":1555,"stem":"误服汽油时采用的解毒剂是","options":{"A":"蛋清","B":"牛奶","C":"弱碱性液体","D":"液体石蜡","E":"米汤"},"answer":"","section":"单选题","id":1555,"book":"护理三基考试3000题","source_url":"https://www.poison.org/articles/gasoline-and-diesel-fuel","original_answer":"D","note":"汽油误服的重要危险是误吸性肺损伤，不应把口服液体石蜡当作解毒方法。","explanation":"汽油误服的重要危险是误吸性肺损伤，不应把口服液体石蜡当作解毒方法。"},{"sourceNumber":1556,"stem":"误服强酸时采用的中和剂是","options":{"A":"蛋清","B":"牛奶","C":"弱碱性液体","D":"液体石蜡","E":"米汤"},"answer":"","section":"单选题","id":1556,"book":"护理三基考试3000题","original_answer":"C","note":"腐蚀性物质摄入后不应自行酸碱中和，反应放热可加重组织损伤。","explanation":"腐蚀性物质摄入后不应自行酸碱中和，反应放热可加重组织损伤。"},{"sourceNumber":1557,"stem":"脑血栓形成最常见的病因是","options":{"A":"高血压","B":"先天性脑动脉瘤","C":"脑动脉硬化","D":"休克","E":"风湿性心脏病"},"answer":"C","section":"单选题","id":1557,"book":"护理三基考试3000题","explanation":"粥样硬化斑块破裂可触发局部血栓，导致脑动脉闭塞。"},{"sourceNumber":1558,"stem":"脑出血最常见的病因是","options":{"A":"高血压","B":"先天性脑动脉瘤","C":"脑动脉硬化","D":"休克","E":"风湿性心脏病"},"answer":"A","section":"单选题","id":1558,"book":"护理三基考试3000题","explanation":"长期高血压损伤脑内穿通小动脉，是自发性深部脑出血的重要病因。"},{"sourceNumber":1559,"stem":"蛛网膜下腔出血最常见的病因是","options":{"A":"高血压","B":"先天性脑动脉瘤","C":"脑动脉硬化","D":"休克","E":"风湿性心脏病"},"answer":"B","section":"单选题","id":1559,"book":"护理三基考试3000题","explanation":"自发性蛛网膜下腔出血常由颅内囊状动脉瘤破裂引起。"},{"sourceNumber":1560,"stem":"胆道完全梗阻常排出","options":{"A":"柏油样便","B":"陶土色便","C":"果酱样便","D":"暗红色便","E":"鲜红色便"},"answer":"B","section":"单选题","id":1560,"book":"护理三基考试3000题","explanation":"胆汁不能进入肠道时，形成正常粪色的粪胆素减少，故粪便灰白。"},{"sourceNumber":1561,"stem":"阿米巴痢疾常排出","options":{"A":"柏油样便","B":"陶土色便","C":"果酱样便","D":"暗红色便","E":"鲜红色便"},"answer":"C","section":"单选题","id":1561,"book":"护理三基考试3000题","explanation":"阿米巴性结肠溃疡可出血、排出坏死组织，与黏液混合形成暗红果酱样便。"},{"sourceNumber":1562,"stem":"上消化道出血常排出","options":{"A":"柏油样便","B":"陶土色便","C":"果酱样便","D":"暗红色便","E":"鲜红色便"},"answer":"A","section":"单选题","id":1562,"book":"护理三基考试3000题","explanation":"上消化道出血后，血红蛋白在肠道内分解，粪便可呈黑、亮、黏的柏油样。"},{"sourceNumber":1563,"stem":"0.005～0.05（0．5%～5%）","options":{"A":"中性杆状核粒细胞","B":"嗜酸粒细胞","C":"中性分叶核粒细胞","D":"淋巴细胞","E":"单核细胞"},"answer":"B","section":"单选题","id":1563,"book":"护理三基考试3000题","explanation":"嗜酸粒细胞在正常外周血仅占少数，过敏或寄生虫感染时可增多。"},{"sourceNumber":1564,"stem":"0.01～0.05（1%～5%）","options":{"A":"中性杆状核粒细胞","B":"嗜酸粒细胞","C":"中性分叶核粒细胞","D":"淋巴细胞","E":"单核细胞"},"answer":"A","section":"单选题","id":1564,"book":"护理三基考试3000题","explanation":"杆状核是较年轻的中性粒细胞，正常比例远低于成熟分叶核。"},{"sourceNumber":1565,"stem":"0.50～0.70（50%～70%）","options":{"A":"中性杆状核粒细胞","B":"嗜酸粒细胞","C":"中性分叶核粒细胞","D":"淋巴细胞","E":"单核细胞"},"answer":"C","section":"单选题","id":1565,"book":"护理三基考试3000题","explanation":"成人分叶核中性粒细胞通常占白细胞最大比例，约半数以上。"},{"sourceNumber":1566,"stem":"0.03～0.08（3%～8%）","options":{"A":"中性杆状核粒细胞","B":"嗜酸粒细胞","C":"中性分叶核粒细胞","D":"淋巴细胞","E":"单核细胞"},"answer":"E","section":"单选题","id":1566,"book":"护理三基考试3000题","explanation":"单核细胞正常占较小比例，进入组织后可分化为巨噬细胞。"},{"sourceNumber":1567,"stem":"0.20～0.40（20%～40%）","options":{"A":"中性杆状核粒细胞","B":"嗜酸粒细胞","C":"中性分叶核粒细胞","D":"淋巴细胞","E":"单核细胞"},"answer":"D","section":"单选题","id":1567,"book":"护理三基考试3000题","explanation":"成人淋巴细胞比例一般次于中性粒细胞，儿童比例可与成人不同。"},{"sourceNumber":1568,"stem":"系统性红斑狼疮的首选药","options":{"A":"阿司匹林","B":"环磷酰胺","C":"肾上腺皮质激素","D":"青霉素","E":"泼尼松"},"answer":"","section":"单选题","id":1568,"book":"护理三基考试3000题","original_answer":"C","note":"狼疮基础治疗及激素需求取决于受累器官和活动度，不能为所有患者统一指定激素首选。","explanation":"狼疮基础治疗及激素需求取决于受累器官和活动度，不能为所有患者统一指定激素首选。"}]