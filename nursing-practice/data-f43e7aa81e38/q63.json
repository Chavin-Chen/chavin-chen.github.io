[{"sourceNumber":1009,"stem":"韩女士，23 岁，颈前区中线甲软骨下方可扪及一个 2cm 大小的肿块，表面光滑，边界清楚，无压痛，随吞咽运动而上下移动，可能的诊断是","options":{"A":"甲状腺癌","B":"甲状腺腺瘤","C":"单纯性甲状腺肿","D":"甲状舌管囊肿","E":"甲状腺功能亢进"},"answer":"B","section":"单选题","explanation":"随吞咽移动、光滑且边界清、未描述随伸舌移动，更支持甲状腺来源的结节。","id":1009,"book":"护理三基考试3000题"},{"sourceNumber":1010,"stem":"俯卧位","options":{"A":"腹部手术","B":"胸部手术","C":"颈部手术","D":"脊柱手术","E":"肛门手术"},"answer":"D","section":"单选题","explanation":"后方脊柱手术需暴露背部，常选俯卧并保护压力点和气道。","id":1010,"book":"护理三基考试3000题"},{"sourceNumber":1011,"stem":"颈仰卧位","options":{"A":"腹部手术","B":"胸部手术","C":"颈部手术","D":"脊柱手术","E":"肛门手术"},"answer":"C","section":"单选题","explanation":"颈前手术以适当颈伸仰卧利于显露切口区域。","id":1011,"book":"护理三基考试3000题"},{"sourceNumber":1012,"stem":"侧卧位","options":{"A":"腹部手术","B":"胸部手术","C":"颈部手术","D":"脊柱手术","E":"肛门手术"},"answer":"B","section":"单选题","explanation":"侧胸入路常取侧卧，使术侧胸壁位于上方。","id":1012,"book":"护理三基考试3000题"},{"sourceNumber":1013,"stem":"仰卧位","options":{"A":"腹部手术","B":"胸部手术","C":"颈部手术","D":"脊柱手术","E":"肛门手术"},"answer":"A","section":"单选题","explanation":"常规前腹部入路用仰卧位可充分暴露腹壁。","id":1013,"book":"护理三基考试3000题"},{"sourceNumber":1014,"stem":"细胞内的主要离子","options":{"A":"钠离子","B":"钾离子","C":"钙离子","D":"锌离子","E":"镁离子"},"answer":"B","section":"单选题","explanation":"钾主要分布在细胞内，是其主要阳离子。","id":1014,"book":"护理三基考试3000题"},{"sourceNumber":1015,"stem":"细胞外的主要离子","options":{"A":"钠离子","B":"钾离子","C":"钙离子","D":"锌离子","E":"镁离子"},"answer":"A","section":"单选题","explanation":"钠主要分布在细胞外，是维持细胞外渗透压的重要阳离子。","id":1015,"book":"护理三基考试3000题"},{"sourceNumber":1016,"stem":"高渗性脱水的常见原因","options":{"A":"急性肠梗阻","B":"感染性休克","C":"肺炎高热","D":"慢性十二指肠瘘","E":"挤压综合征"},"answer":"C","section":"单选题","explanation":"高热、呼吸加快使不显性失水增加，若饮水不足可发生失水多于失钠。","id":1016,"book":"护理三基考试3000题"},{"sourceNumber":1017,"stem":"低渗性脱水的常见原因","options":{"A":"急性肠梗阻","B":"感染性休克","C":"肺炎高热","D":"慢性十二指肠瘘","E":"挤压综合征"},"answer":"D","section":"单选题","explanation":"长期消化液丢失同时补水不足以补钠时，可能出现低渗性脱水。","id":1017,"book":"护理三基考试3000题"},{"sourceNumber":1018,"stem":"等渗性脱水的常见原因","options":{"A":"急性肠梗阻","B":"感染性休克","C":"肺炎高热","D":"慢性十二指肠瘘","E":"挤压综合征"},"answer":"A","section":"单选题","explanation":"肠梗阻使近等渗的消化液滞留在肠腔，循环有效容量下降。","id":1018,"book":"护理三基考试3000题"},{"sourceNumber":1019,"stem":"代谢性酸中毒最易发生于","options":{"A":"急性肠梗阻","B":"感染性休克","C":"肺炎高热","D":"慢性十二指肠瘘","E":"挤压综合征"},"answer":"D","section":"单选题","explanation":"十二指肠液含碳酸氢盐，持续瘘出可造成碱丢失性代谢性酸中毒。","id":1019,"book":"护理三基考试3000题"},{"sourceNumber":1020,"stem":"中心静脉压在5cmH2O 以下","options":{"A":"心功能不全","B":"血容量已补足","C":"急性肾衰","D":"血容量不足","E":"血管张力增高"},"answer":"D","section":"单选题","explanation":"中心静脉压偏低可能提示右心前负荷不足，还需结合灌注和呼吸情况。","id":1020,"book":"护理三基考试3000题"},{"sourceNumber":1021,"stem":"中心静脉压在12cmH2O 以上, 而血压低","options":{"A":"心功能不全","B":"血容量已补足","C":"急性肾衰","D":"血容量不足","E":"血管张力增高"},"answer":"A","section":"单选题","explanation":"低血压伴静脉回流压力升高提示需评估泵功能或阻塞因素，而非盲目补液。","id":1021,"book":"护理三基考试3000题"},{"sourceNumber":1022,"stem":"中心静脉压高于正常,病人少尿或无尿","options":{"A":"心功能不全","B":"血容量已补足","C":"急性肾衰","D":"血容量不足","E":"血管张力增高"},"answer":"","section":"单选题","original_answer":"C","note":"高中心静脉压加少尿可见于多种心、肾或容量问题，不能单据此确定急性肾衰。","explanation":"高中心静脉压加少尿可见于多种心、肾或容量问题，不能单据此确定急性肾衰。","id":1022,"book":"护理三基考试3000题"},{"sourceNumber":1023,"stem":"中心静脉压高,血压正常","options":{"A":"心功能不全","B":"血容量已补足","C":"急性肾衰","D":"血容量不足","E":"血管张力增高"},"answer":"","section":"单选题","original_answer":"B","note":"正常血压和高中心静脉压不足以证明复苏充分，还需观察灌注和容量反应。","explanation":"正常血压和高中心静脉压不足以证明复苏充分，还需观察灌注和容量反应。","id":1023,"book":"护理三基考试3000题"},{"sourceNumber":1024,"stem":"硫喷妥钠麻醉术前选用","options":{"A":"阿托品","B":"吗啡","C":"氯丙嗪","D":"地西泮（安定）","E":"苯巴比妥钠"},"answer":"","section":"单选题","original_answer":"E","note":"硫喷妥钠诱导前不必常规合用苯巴比妥，需个体化麻醉方案。","explanation":"硫喷妥钠诱导前不必常规合用苯巴比妥，需个体化麻醉方案。","id":1024,"book":"护理三基考试3000题"}]