[{"sourceNumber":1969,"stem":"确诊下肢静脉疾病最可靠的检查方法是","options":{"A":"深静脉回流试验","B":"浅静脉瓣膜功能试验","C":"下肢静脉造影","D":"交通支瓣膜功能试验","E":"下肢静脉压测定"},"answer":"C","section":"单选题","id":1969,"book":"护理三基考试3000题","explanation":"静脉造影能显示管腔和回流情况；临床许多下肢静脉疾病首选无创超声检查。"},{"sourceNumber":1970,"stem":"甲状腺手术常用的麻醉方法是","options":{"A":"吸入麻醉","B":"静脉麻醉","C":"复合麻醉","D":"神经阻滞麻醉","E":"表面麻醉"},"answer":"","section":"单选题","id":1970,"book":"护理三基考试3000题","original_answer":"D","note":"甲状腺手术的麻醉方式受术式及患者情况影响，原题把神经阻滞笼统定为常用方式。","explanation":"甲状腺手术的麻醉方式受术式及患者情况影响，原题把神经阻滞笼统定为常用方式。"},{"sourceNumber":1971,"stem":"无需特殊治疗的脑损伤是","options":{"A":"脑搓裂伤","B":"脑震荡","C":"颅内血肿","D":"颅内压增高","E":"脑疝"},"answer":"B","section":"单选题","id":1971,"book":"护理三基考试3000题","explanation":"单纯脑震荡多以休息和观察为主，但需监测恶化以排除迟发性颅内损伤。"},{"sourceNumber":1972,"stem":"骨折必不可少的检查是","options":{"A":"CT","B":"X 线","C":"心电图","D":"超声波","E":"血生化"},"answer":"B","section":"单选题","id":1972,"book":"护理三基考试3000题","explanation":"骨折常用正侧位X线了解断端移位和对位，隐匿损伤还可能需要CT或MRI。"},{"sourceNumber":1973,"stem":"腹外疝的发病因素中最重要的是","options":{"A":"妊娠","B":"长期便秘","C":"慢性咳嗽","D":"排尿困难","E":"腹壁强度降低"},"answer":"E","section":"单选题","id":1973,"book":"护理三基考试3000题","explanation":"腹壁薄弱提供疝内容物突出的通道，腹内压增高可进一步促发。"},{"sourceNumber":1974,"stem":"对诊断尚未明确的急腹症患者，可以采取的措施是","options":{"A":"用吗啡止痛","B":"用阿托品解痉","C":"给患者灌肠","D":"使用腹泻药","E":"用热水袋热敷"},"answer":"","section":"单选题","id":1974,"book":"护理三基考试3000题","original_answer":"B","note":"未明确病因的急腹痛需及时评估，不能无条件将阿托品列为可用措施。","explanation":"未明确病因的急腹痛需及时评估，不能无条件将阿托品列为可用措施。"},{"sourceNumber":1975,"stem":"外科最常见的腹外疝是","options":{"A":"腹股沟直疝","B":"腹股沟斜疝","C":"股疝","D":"切口疝","E":"脐疝"},"answer":"B","section":"单选题","id":1975,"book":"护理三基考试3000题","explanation":"疝囊从腹股沟深环进入腹股沟管，可沿精索下降至阴囊，是斜疝与直疝的重要区别。"},{"sourceNumber":1976,"stem":"直肠癌的转移途径是","options":{"A":"直接蔓延","B":"腹腔种植转移","C":"血运转移","D":"淋巴转移","E":"远处转移"},"answer":"D","section":"单选题","id":1976,"book":"护理三基考试3000题","explanation":"肿瘤细胞可沿直肠的淋巴引流途径进入区域淋巴结。"},{"sourceNumber":1977,"stem":"张力性气胸急救时首先应","options":{"A":"锁骨中线第 2 肋间行胸膜腔穿刺，尽快排气减压","B":"迅速封闭胸壁伤口","C":"清创","D":"气管切开","E":"加压吸氧"},"answer":"A","section":"单选题","id":1977,"book":"护理三基考试3000题","explanation":"迅速解除高压积气可改善肺受压和静脉回流，具体减压方式及位置按专业急救流程。"},{"sourceNumber":1978,"stem":"急性蜂窝织炎的致病菌为","options":{"A":"白色念珠菌","B":"新型隐球菌","C":"乙型溶血性链球菌","D":"拟杆菌","E":"绿脓杆菌"},"answer":"C","section":"单选题","id":1978,"book":"护理三基考试3000题","explanation":"溶血性链球菌可在疏松结缔组织中扩散，引起边界不清的蜂窝织炎。"},{"sourceNumber":1979,"stem":"目前根治原发性肝癌的最好的方法是","options":{"A":"手术治疗","B":"化学治疗","C":"放射治疗","D":"免疫治疗","E":"止痛治疗"},"answer":"A","section":"单选题","id":1979,"book":"护理三基考试3000题","explanation":"局限且符合切除条件的肝癌可获得根治性切除，部分患者也适合移植或消融。"},{"sourceNumber":1980,"stem":"细胞外液中主要的阳离子是","options":{"A":"Fe2+","B":"Mg2+","C":"K+","D":"NA+","E":"CA2+"},"answer":"D","section":"单选题","id":1980,"book":"护理三基考试3000题","explanation":"钠是细胞外液含量最高的阳离子，对细胞外容量及渗透压很重要。"},{"sourceNumber":1981,"stem":"破伤风属于","options":{"A":"特异性感染","B":"混合性感染","C":"非特异性感染","D":"化脓性感染","E":"慢性感染"},"answer":"A","section":"单选题","id":1981,"book":"护理三基考试3000题","explanation":"破伤风有特定病原和特征性神经肌肉表现，传统外科学归为特异性感染。"},{"sourceNumber":1982,"stem":"各种类型休克基本病理变化是","options":{"A":"血压下降","B":"心率加快","C":"脉压减小","D":"尿量减少","E":"有效循环血量锐减"},"answer":"E","section":"单选题","id":1982,"book":"护理三基考试3000题","explanation":"休克的共同终点是有效组织灌注不足；某些类型并无实际血液总量减少。"},{"sourceNumber":1983,"stem":"心脏骤停后最容易发生的继发性病理改变是","options":{"A":"肺水肿","B":"急性肾衰竭","C":"急性肝坏死","D":"脑缺氧和脑水肿","E":"心肌缺氧性损伤"},"answer":"D","section":"单选题","id":1983,"book":"护理三基考试3000题","explanation":"脑耗氧量高而能量储备少，循环中断后易发生缺氧性脑损伤及水肿。"},{"sourceNumber":1984,"stem":"莫菲氏征阳性常见于","options":{"A":"急性阑尾炎","B":"急性胆囊炎","C":"急性胆管炎","D":"急性胰腺炎","E":"急性胃肠炎"},"answer":"B","section":"单选题","id":1984,"book":"护理三基考试3000题","explanation":"胆囊炎时吸气使胆囊下降触及压痛点，疼痛导致吸气中断。"}]