[{"sourceNumber":1025,"stem":"孕妇临产前禁用","options":{"A":"阿托品","B":"吗啡","C":"氯丙嗪","D":"地西泮（安定）","E":"苯巴比妥钠"},"answer":"","section":"单选题","original_answer":"E","note":"药物影响胎儿和新生儿呼吸，可有专科适应证，不能笼统将苯巴比妥列为绝对禁用。","explanation":"药物影响胎儿和新生儿呼吸，可有专科适应证，不能笼统将苯巴比妥列为绝对禁用。","id":1025,"book":"护理三基考试3000题"},{"sourceNumber":1026,"stem":"甲状腺功能亢进症病人术前不宜使用","options":{"A":"阿托品","B":"吗啡","C":"氯丙嗪","D":"地西泮（安定）","E":"苯巴比妥钠"},"answer":"A","section":"单选题","explanation":"阿托品可明显加快心率，已伴心动过速的甲亢患者需谨慎评估。","id":1026,"book":"护理三基考试3000题"},{"sourceNumber":1027,"stem":"血容量不足病人手术不宜使用","options":{"A":"阿托品","B":"吗啡","C":"氯丙嗪","D":"地西泮（安定）","E":"苯巴比妥钠"},"answer":"C","section":"单选题","explanation":"氯丙嗪可使血管扩张、血压下降，低容量时尤其可能恶化灌注。","id":1027,"book":"护理三基考试3000题"},{"sourceNumber":1028,"stem":"同卵双生兄弟组织互相移植","options":{"A":"自体移植","B":"同质移植","C":"同种异体移植","D":"异体异种移植","E":"再植"},"answer":"B","section":"单选题","explanation":"同卵双生者遗传背景基本相同，组织互移属于同系移植。","id":1028,"book":"护理三基考试3000题"},{"sourceNumber":1029,"stem":"同父异母兄弟间组织移植","options":{"A":"自体移植","B":"同质移植","C":"同种异体移植","D":"异体异种移植","E":"再植"},"answer":"C","section":"单选题","explanation":"同种不同个体即使有亲缘关系，也属同种异体移植。","id":1029,"book":"护理三基考试3000题"},{"sourceNumber":1030,"stem":"小猪皮移植于烧伤创面","options":{"A":"自体移植","B":"同质移植","C":"同种异体移植","D":"异体异种移植","E":"再植"},"answer":"D","section":"单选题","explanation":"猪组织移植给人，供受者属于不同物种，故为异种移植。","id":1030,"book":"护理三基考试3000题"},{"sourceNumber":1031,"stem":"病人头皮移植于烧伤创面","options":{"A":"自体移植","B":"同质移植","C":"同种异体移植","D":"异体异种移植","E":"再植"},"answer":"A","section":"单选题","explanation":"供体和受体为同一患者，属于自体移植。","id":1031,"book":"护理三基考试3000题"},{"sourceNumber":1032,"stem":"腹腔穿刺吸出的血液迅速凝固提示","options":{"A":"实质性脏器损伤","B":"胃肠道损伤","C":"穿入血管或血肿内","D":"膀胱损伤","E":"绞窄性疝"},"answer":"C","section":"单选题","explanation":"穿入血管或近期血肿可抽到仍具凝固能力的新鲜血。","id":1032,"book":"护理三基考试3000题"},{"sourceNumber":1033,"stem":"X 线检查膈下有游离气体","options":{"A":"实质性脏器损伤","B":"胃肠道损伤","C":"穿入血管或血肿内","D":"膀胱损伤","E":"绞窄性疝"},"answer":"B","section":"单选题","explanation":"空腔脏器破裂后气体可逸入腹膜腔，在膈下形成游离气体。","id":1033,"book":"护理三基考试3000题"},{"sourceNumber":1034,"stem":"腹腔穿刺吸出的血液不凝固提示","options":{"A":"实质性脏器损伤","B":"胃肠道损伤","C":"穿入血管或血肿内","D":"膀胱损伤","E":"绞窄性疝"},"answer":"A","section":"单选题","explanation":"腹腔游离血液经搅动、去纤维化可不凝固，提示腹腔内出血。","id":1034,"book":"护理三基考试3000题"},{"sourceNumber":1035,"stem":"腹部大手术后肠梗阻","options":{"A":"机械性肠梗阻","B":"机械性绞窄性肠梗阻","C":"麻痹性肠梗阻","D":"痉挛性肠梗阻","E":"血运性肠梗阻"},"answer":"C","section":"单选题","explanation":"腹部术后早期可因肠道暂时失去蠕动而出现麻痹性肠梗阻。","id":1035,"book":"护理三基考试3000题"},{"sourceNumber":1036,"stem":"铅中毒引起的肠梗阻","options":{"A":"机械性肠梗阻","B":"机械性绞窄性肠梗阻","C":"麻痹性肠梗阻","D":"痉挛性肠梗阻","E":"血运性肠梗阻"},"answer":"","section":"单选题","original_answer":"C","note":"铅中毒所致肠绞痛可表现为痉挛性动力障碍，不能笼统按麻痹性梗阻判分。","explanation":"铅中毒所致肠绞痛可表现为痉挛性动力障碍，不能笼统按麻痹性梗阻判分。","id":1036,"book":"护理三基考试3000题"},{"sourceNumber":1037,"stem":"肠系膜扭转","options":{"A":"机械性肠梗阻","B":"机械性绞窄性肠梗阻","C":"麻痹性肠梗阻","D":"痉挛性肠梗阻","E":"血运性肠梗阻"},"answer":"B","section":"单选题","explanation":"肠系膜扭转既阻断肠腔又影响血供，属于机械性绞窄。","id":1037,"book":"护理三基考试3000题"},{"sourceNumber":1038,"stem":"结核性腹膜炎所致的粘连性肠梗阻","options":{"A":"机械性肠梗阻","B":"机械性绞窄性肠梗阻","C":"麻痹性肠梗阻","D":"痉挛性肠梗阻","E":"血运性肠梗阻"},"answer":"A","section":"单选题","explanation":"腹膜炎形成粘连带可牵拉、压迫肠管，造成机械性梗阻。","id":1038,"book":"护理三基考试3000题"},{"sourceNumber":1039,"stem":"易误诊为胃病","options":{"A":"胆总管结石","B":"肝内胆管结石","C":"慢性胆囊炎","D":"急性胆囊炎","E":"胆囊结石"},"answer":"C","section":"单选题","explanation":"慢性胆囊炎可表现为上腹饱胀和消化不适，容易与胃病混淆。","id":1039,"book":"护理三基考试3000题"},{"sourceNumber":1040,"stem":"易误诊为肝炎","options":{"A":"胆总管结石","B":"肝内胆管结石","C":"慢性胆囊炎","D":"急性胆囊炎","E":"胆囊结石"},"answer":"B","section":"单选题","explanation":"肝内结石合并梗阻或感染可有黄疸和肝功能异常，与肝炎表现重叠。","id":1040,"book":"护理三基考试3000题"}]