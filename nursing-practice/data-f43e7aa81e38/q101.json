[{"sourceNumber":1617,"stem":"术后进食的指征是","options":{"A":"腹胀消失","B":"肛门排气","C":"术后 2～3 天","D":"胃肠减压吸出液减少","E":"无恶心、呕吐"},"answer":"","section":"单选题","original_answer":"B","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1617,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1618,"stem":"该病人腹腔引流管的护理，错误的是","options":{"A":"妥善固定，避免脱落","B":"保持引流通畅","C":"观察引流量及性质","D":"每日定时冲洗引流管","E":"严格掌握拔管指征"},"answer":"D","section":"单选题","original_answer":"D","note":"腹腔引流通常需保持通畅并监测引流量和性质，无冲洗指征时不应例行打开系统。","explanation":"腹腔引流通常需保持通畅并监测引流量和性质，无冲洗指征时不应例行打开系统。","id":1618,"book":"护理三基考试3000题"},{"sourceNumber":1619,"stem":"若手术后第 5 天，病人体温再次升高至 39℃，大便次数增多，解粘液便，并有尿频、尿急症状，首先考虑的并发症是","options":{"A":"膈下脓肿","B":"肠间脓肿","C":"盆腔脓肿","D":"切口感染","E":"急性肠炎"},"answer":"C","section":"单选题","id":1619,"book":"护理三基考试3000题","explanation":"盆腔积脓会刺激直肠或膀胱，出现里急后重、排便次数增加或尿路刺激症状。"},{"sourceNumber":1620,"stem":"该病人的基本病因是","options":{"A":"胃溃疡","B":"十二指肠溃疡","C":"食管一胃底静脉曲张","D":"胃癌","E":"肝硬化"},"answer":"","section":"单选题","original_answer":"B","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1620,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1621,"stem":"目前的情况应考虑发生","options":{"A":"穿孔","B":"幽门梗阻","C":"肠系膜动脉栓塞","D":"失血性休克","E":"肝性昏迷"},"answer":"","section":"单选题","original_answer":"D","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1621,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1622,"stem":"该病情的观察重点是","options":{"A":"生命体征","B":"意识","C":"尿量","D":"瞳孔变化","E":"四肢活动度"},"answer":"","section":"单选题","original_answer":"A","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1622,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1623,"stem":"其疝环是","options":{"A":"股环","B":"卵圆窝","C":"腹股沟管浅环","D":"腹股沟管深环","E":"腹股沟三角"},"answer":"","section":"单选题","original_answer":"D","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1623,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1624,"stem":"回纳疝块时，可闻及肠鸣音，疝内容物最可能的是","options":{"A":"乙状结肠","B":"小肠","C":"膀胱","D":"大网膜","E":"直肠"},"answer":"B","section":"单选题","id":1624,"book":"护理三基考试3000题","explanation":"可回纳肿物伴肠鸣音提示内容物中有气液和蠕动的肠管。"},{"sourceNumber":1625,"stem":"若病人用力排便时，疝块突然增大不能回纳，伴有局部疼痛和压痛，此时疝的临床类型属于","options":{"A":"易复性疝","B":"难复性疝","C":"嵌顿性疝","D":"滑动性疝","E":"绞窄性疝"},"answer":"C","section":"单选题","id":1625,"book":"护理三基考试3000题","explanation":"突发疼痛、疝块不能回纳提示内容物卡在疝环，是否绞窄还需评估缺血。"},{"sourceNumber":1626,"stem":"该患者诊断为闭合性腹部损伤，考虑最可能损伤的脏器为","options":{"A":"肝脏","B":"脾脏","C":"胃","D":"胰腺","E":"膀胱"},"answer":"","section":"单选题","original_answer":"B","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1626,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1627,"stem":"对协助诊断有意义的检查是以下各项，但除外","options":{"A":"B 超","B":"CT","C":"血常规","D":"腹腔穿刺","E":"肺功能测定"},"answer":"","section":"单选题","original_answer":"E","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1627,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1628,"stem":"该患者手术治疗术前准备包括以下各项，但除外","options":{"A":"术前常规禁饮食","B":"药物皮肤过敏试验","C":"术前通便灌肠","D":"配血、备皮","E":"常规实验室检查"},"answer":"","section":"单选题","original_answer":"C","note":"本题引用的共同病例情境在原文中缺失，暂停判分。","id":1628,"book":"护理三基考试3000题","explanation":""},{"sourceNumber":1629,"stem":"0.2%溶液可以用于手消毒的是","options":{"A":"碘酊","B":"过氧乙酸","C":"戊二醛","D":"漂白粉","E":"乙醇"},"answer":"","section":"单选题","id":1629,"book":"护理三基考试3000题","original_answer":"B","note":"过氧乙酸对皮肤具刺激性，不能把该浓度列为日常手消毒通用方案。","explanation":"过氧乙酸对皮肤具刺激性，不能把该浓度列为日常手消毒通用方案。"},{"sourceNumber":1630,"stem":"可用于胃镜消毒的是","options":{"A":"碘酊","B":"过氧乙酸","C":"戊二醛","D":"漂白粉","E":"乙醇"},"answer":"C","section":"单选题","id":1630,"book":"护理三基考试3000题","explanation":"胃镜接触黏膜，需彻底清洗后作高水平消毒；制剂及时间遵循器械和产品说明。"},{"sourceNumber":1631,"stem":"皮肤消毒和一般皮肤感染可采用的是","options":{"A":"碘酊","B":"过氧乙酸","C":"戊二醛","D":"漂白粉","E":"乙醇"},"answer":"A","section":"单选题","raw":"皮肤消毒和一般皮肤感染可采用的是答案：A\nA:．腹股沟斜疝B:．腹股沟直疝C:．股疝\nD:．切口疝E:．脐疝","note":"原文选项跨题错位，已按共用备选项组（原题 1630）复原。","id":1631,"book":"护理三基考试3000题","explanation":"碘酊有杀微生物作用，也有刺激性，应区分完整皮肤、黏膜和开放创面。"},{"sourceNumber":1632,"stem":"最易发生嵌顿的腹外疝","options":{"A":"腹股沟斜疝","B":"腹股沟直疝","C":"股疝","D":"切口疝","E":"脐疝"},"answer":"C","section":"单选题","id":1632,"book":"护理三基考试3000题","explanation":"股环狭小且边缘坚韧，疝内容物进入后较难还纳，所以嵌顿风险较高。"}]